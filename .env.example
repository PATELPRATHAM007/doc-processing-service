PROJECT_NAME="Async Document Processing Service"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/doc_processing_db"

# Redis Broker Configuration
REDIS_URL="redis://localhost:6379/0"
QUEUE_NAME="document_processing_queue"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Document Storage & Limits
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=10485760

# Google Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Logger Configuration
LOG_MAX_BYTES=1073741824
LOG_BACKUP_COUNT=3
LOG_LEVEL=INFO
LOG_CONSOLE=false
