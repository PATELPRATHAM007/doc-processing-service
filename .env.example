PROJECT_NAME="Async Document Processing Service"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=9000

# PostgreSQL Database Configuration
# If using Docker (docker compose up -d db): port is 6432, password is postgrespassword
# If using native local Postgres: default port is 5432
DATABASE_URL="postgresql+psycopg2://postgres:postgrespassword@localhost:6432/doc_processing_db"

# Redis Broker Configuration
# If using Docker (docker compose up -d redis): port is 7379
# If using native local Redis: default port is 6379
REDIS_URL="redis://localhost:7379/0"
QUEUE_NAME="document_processing_queue"
CELERY_BROKER_URL="redis://localhost:7379/0"
CELERY_RESULT_BACKEND="redis://localhost:7379/0"

# Document Storage & Limits
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=10485760

# OCR Provider Selection ("gemini" or "paddleocr_vl")
OCR_PROVIDER="gemini"

# Google Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"

# PaddleOCR-VL-1.6 Configuration
PADDLEOCR_VL_PIPELINE_VERSION="v1.6"
PADDLEOCR_VL_MODEL_NAME="PaddlePaddle/PaddleOCR-VL-1.6"
PADDLEOCR_VL_BACKEND="vllm-server"
PADDLEOCR_VL_SERVER_URL="http://localhost:8080/v1"
PADDLEOCR_VL_DEVICE="cpu"
PADDLEOCR_VL_TIMEOUT_SECONDS=120

# Logger Configuration
LOG_MAX_BYTES=1073741824
LOG_BACKUP_COUNT=3
LOG_LEVEL=INFO
LOG_CONSOLE=false
